# Бот MAX для заявок с формы (читаются сервером в рантайме)
# chat_id: напишите боту и выполните npm run max:chat-id
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# ID счётчика Яндекс.Метрики (нужен при сборке: npm run build)
PUBLIC_YANDEX_METRIKA_ID=

# Порт и хост Node-сервера
PORT=3000
HOST=0.0.0.0

# Необязательно: адрес Bot API MAX (по умолчанию https://platform-api.max.ru)
# MAX_API_URL=
