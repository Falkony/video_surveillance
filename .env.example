# Telegram-бот для заявок с формы (читаются сервером в рантайме)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ID счётчика Яндекс.Метрики (нужен при сборке: npm run build)
PUBLIC_YANDEX_METRIKA_ID=

# Порт и хост Node-сервера
PORT=3000
HOST=0.0.0.0

# Необязательно: свой адрес Telegram Bot API (прокси), если api.telegram.org
# недоступен с сервера. По умолчанию https://api.telegram.org
# TELEGRAM_API_URL=
