---
import ProjectsGallery from '~/components/ProjectsGallery.astro'
import PriceList from '~/components/PriceList.astro'
import { projects } from '~/data/landing'
---

<section id="projects" class="relative w-full overflow-hidden bg-neutral-950 py-24" aria-labelledby="projects-title">
  <div class="absolute top-1/4 left-1/3 -z-0 size-[400px] rounded-full bg-primary/10 blur-[150px]"></div>
  <div class="absolute right-1/3 bottom-1/4 -z-0 size-[400px] rounded-full bg-primary/15 blur-[150px]"></div>

  <div class="relative mb-16 px-4 text-center">
    <h2 id="projects-title" class="mb-4 text-4xl font-bold text-white sm:text-5xl">
      {projects.title} <span class="text-primary">{projects.titleAccent}</span>
    </h2>
    <p class="mx-auto max-w-4xl text-lg text-neutral-400">{projects.description}</p>
  </div>

  <div class="relative w-full px-4 sm:px-8 lg:px-12 xl:px-16">
    <div class="mx-auto grid max-w-[2000px] grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <ProjectsGallery />
      <PriceList />
    </div>
  </div>
</section>
