---
import { Icon } from 'astro-icon/components'
import Logo from '~/components/Logo.astro'
import { site } from '~/data/site'
import { anchorPrefix } from '~/utils/path'

const prefix = anchorPrefix(Astro.url)

const infoLinks = [
  { label: 'Наши проекты', href: `${prefix}#projects` },
  { label: 'Прайс-лист', href: `${prefix}#price` },
  { label: 'Отзывы клиентов', href: `${prefix}#reviews` },
  { label: 'О компании', href: `${prefix}#services` },
  { label: 'Политика конфиденциальности', href: '/privacy' }
]

const contacts = [
  { label: site.phoneDisplay, href: `tel:${site.phone}`, icon: 'lucide:phone', goal: 'phone_click' },
  { label: site.email, href: `mailto:${site.email}`, icon: 'lucide:mail' },
  { label: site.telegramHandle, href: site.telegram, icon: 'simple-icons:telegram', external: true }
]
---

<div class="relative z-10 flex items-center" aria-hidden="true">
  <div class="h-px flex-1 bg-neutral-800"></div>
  <Icon name="lucide:camera" class="mx-3 size-5 text-neutral-400" />
  <div class="h-px flex-1 bg-neutral-800"></div>
</div>

<footer class="relative overflow-hidden bg-neutral-950">
  <div class="absolute top-0 left-1/4 -z-10 hidden size-[400px] rounded-full bg-primary/10 blur-[120px] lg:block"></div>
  <div class="absolute right-1/4 bottom-0 -z-10 hidden size-[400px] rounded-full bg-primary/5 blur-[120px] lg:block"></div>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="mx-auto flex max-w-5xl flex-col justify-center gap-8 md:flex-row md:gap-20">
      <div class="flex flex-1 flex-col items-center text-center md:items-start md:text-left">
        <div class="mb-3"><Logo /></div>
        <p class="mb-4 text-sm text-neutral-400">
          Профессиональные системы видеонаблюдения и безопасности для вашего дома и бизнеса в Нижнем Новгороде
        </p>
        <div class="flex flex-wrap justify-center gap-2 md:justify-start">
          <span class="inline-flex items-center gap-1 rounded-md bg-primary/10 px-2 py-1 text-xs font-medium text-primary ring ring-inset ring-primary/25">
            <Icon name="lucide:award" class="size-3" />
            7+ лет на рынке
          </span>
          <span class="inline-flex items-center gap-1 rounded-md bg-green-400/10 px-2 py-1 text-xs font-medium text-green-400 ring ring-inset ring-green-400/25">
            <Icon name="lucide:briefcase" class="size-3" />
            500+ проектов
          </span>
        </div>
      </div>

      <div class="grid flex-1 grid-cols-2 gap-6 px-2 md:gap-12 md:px-0">
        <nav aria-label="Информация" class="flex flex-col items-start px-1 text-left sm:px-5">
          <p class="mb-3 text-base font-bold text-white md:mb-4 md:text-lg">Информация</p>
          <ul class="space-y-2">
            {infoLinks.map(link => (
              <li>
                <a href={link.href} class="group inline-flex items-center gap-1 text-xs text-neutral-400 transition-colors hover:text-primary md:gap-2 md:text-sm">
                  <Icon name="lucide:chevron-right" class="size-3 shrink-0 transition-transform group-hover:translate-x-1" />
                  <span class="break-words">{link.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex flex-col items-start px-1 text-left sm:px-5">
          <p class="mb-3 text-base font-bold text-white md:mb-4 md:text-lg">Контакты</p>
          <address class="not-italic">
            <ul class="space-y-2">
              {contacts.map(c => (
                <li>
                  <a
                    href={c.href}
                    data-goal={c.goal}
                    target={c.external ? '_blank' : undefined}
                    rel={c.external ? 'noopener' : undefined}
                    class="inline-flex items-center gap-1 text-xs text-neutral-400 transition-colors hover:text-primary md:gap-2 md:text-sm"
                  >
                    <Icon name={c.icon} class="size-3 shrink-0" />
                    <span class="break-all">{c.label}</span>
                  </a>
                </li>
              ))}
              <li class="inline-flex items-center gap-1 text-xs text-neutral-400 md:gap-2 md:text-sm">
                <Icon name="lucide:map-pin" class="size-3 shrink-0" />
                {site.city}
              </li>
              <li class="inline-flex items-center gap-1 text-xs text-neutral-400 md:gap-2 md:text-sm">
                <Icon name="lucide:clock" class="size-3 shrink-0" />
                Ежедневно {site.openingHours.opens}–{site.openingHours.closes}
              </li>
            </ul>
          </address>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-neutral-800">
    <div class="mx-auto flex max-w-7xl flex-col items-center gap-2 px-4 py-4 text-center sm:px-6 md:py-6 lg:px-8">
      <p class="text-sm text-neutral-400">© {new Date().getFullYear()} {site.brand}. Все права защищены.</p>
      <p class="text-xs leading-relaxed text-neutral-400">
        {site.legal.name}<br class="sm:hidden" />
        <span class="hidden sm:inline"> | </span>
        ИНН {site.legal.inn}<br class="sm:hidden" />
        <span class="hidden sm:inline"> | </span>
        ОГРН {site.legal.ogrn}
      </p>
    </div>
  </div>
</footer>
